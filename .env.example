# Configuration reference only: TraceDesk reads the process environment, not this file.
# Do not commit a real API key. See docs/deployment.md for shell commands.
TRACEDESK_PROVIDER=extractive
TRACEDESK_RETRIEVAL_METHOD=ngram
TRACEDESK_DATABASE=.tracedesk/tracedesk.db
TRACEDESK_DEMO_MODE=true

# Set provider=llm to enable a real function-calling model. No automatic fallback.
TRACEDESK_BASE_URL=https://api.deepseek.com/v1
TRACEDESK_MODEL=deepseek-chat
TRACEDESK_API_KEY=
TRACEDESK_TIMEOUT_SECONDS=30
TRACEDESK_MAX_MODEL_STEPS=6
TRACEDESK_MAX_TOOL_CALLS=12
TRACEDESK_MAX_COMPLETION_TOKENS=1800
TRACEDESK_MAX_TOOL_OUTPUT_CHARS=16000
TRACEDESK_MAX_MESSAGE_CHARS=2000
TRACEDESK_MAX_HISTORY_TURNS=6
TRACEDESK_ACTION_TTL_SECONDS=600
TRACEDESK_RUN_LEASE_SECONDS=300
