# 配置参考：程序读取进程环境，不自动加载本文件。
# 不填写真实密钥或私人路径。路径示例相对于项目目录。
TRACEDESK_PROVIDER=extractive
TRACEDESK_RETRIEVAL_METHOD=ngram
TRACEDESK_DATABASE=.tracedesk/tracedesk.db
TRACEDESK_DEMO_MODE=true

# 聊天模型：显式切换为 llm 后启用，不自动降级。
TRACEDESK_BASE_URL=https://api.deepseek.com/v1
TRACEDESK_MODEL=deepseek-chat
TRACEDESK_API_KEY=
TRACEDESK_TIMEOUT_SECONDS=30
TRACEDESK_MAX_MODEL_STEPS=6
TRACEDESK_MAX_TOOL_CALLS=12
TRACEDESK_MAX_COMPLETION_TOKENS=1800
TRACEDESK_MAX_TOOL_OUTPUT_CHARS=16000
TRACEDESK_MAX_MESSAGE_CHARS=2000
TRACEDESK_MAX_HISTORY_TURNS=6
TRACEDESK_ACTION_TTL_SECONDS=600
TRACEDESK_RUN_LEASE_SECONDS=300

# 文档：none / mineru_http / mineru_cli。
TRACEDESK_KNOWLEDGE_PDF_PARSER=none
TRACEDESK_KNOWLEDGE_MINERU_BASE_URL=http://127.0.0.1:8000
TRACEDESK_KNOWLEDGE_MINERU_CLI_PATH=
TRACEDESK_KNOWLEDGE_MINERU_BACKEND=pipeline
TRACEDESK_KNOWLEDGE_MINERU_LANGUAGE=ch
TRACEDESK_KNOWLEDGE_MAX_UPLOAD_BYTES=20971520
TRACEDESK_KNOWLEDGE_MAX_CHUNK_CHARACTERS=1200
TRACEDESK_KNOWLEDGE_PARSE_TIMEOUT_SECONDS=120
TRACEDESK_KNOWLEDGE_BUILD_TIMEOUT_SECONDS=300
TRACEDESK_KNOWLEDGE_MAX_QUERY_CHARACTERS=2000
TRACEDESK_KNOWLEDGE_MAX_SEARCH_RESULTS=50
TRACEDESK_KNOWLEDGE_RRF_K=60

# 嵌入：none / onnx / openai；模型与维度必须显式配置。
TRACEDESK_KNOWLEDGE_EMBEDDING_PROVIDER=none
TRACEDESK_KNOWLEDGE_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
TRACEDESK_KNOWLEDGE_EMBEDDING_MODEL=
TRACEDESK_KNOWLEDGE_EMBEDDING_API_KEY=
TRACEDESK_KNOWLEDGE_EMBEDDING_DIMENSIONS=0
TRACEDESK_KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
TRACEDESK_KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=60
TRACEDESK_KNOWLEDGE_EMBEDDING_QUERY_PREFIX=
TRACEDESK_KNOWLEDGE_ONNX_MODEL_PATH=
TRACEDESK_KNOWLEDGE_TOKENIZER_PATH=
TRACEDESK_KNOWLEDGE_TOKENIZER_MAX_LENGTH=512
# 本地示例模型：Xenova/bge-small-zh-v1.5，512 维 CLS，显式下载后再启用。
# 相对路径示例：
# .tracedesk/models/bge-small-zh-v1.5/onnx/model_quantized.onnx
# .tracedesk/models/bge-small-zh-v1.5/tokenizer.json
# 将路径解析成绝对路径后设置 ONNX_MODEL_PATH / TOKENIZER_PATH。
# 该模型可先选择 MAX_CHUNK_CHARACTERS=320；超 token 上限会报错。

# 来源图：local / neo4j；关系抽取 explicit / model。
TRACEDESK_GRAPH_BACKEND=local
TRACEDESK_GRAPH_EXTRACTION=explicit
TRACEDESK_GRAPH_MAX_HOPS=3
TRACEDESK_GRAPH_MAX_FACTS=5000
TRACEDESK_GRAPH_MAX_NODES=2000
TRACEDESK_GRAPH_MAX_EXPANSIONS=20000
TRACEDESK_GRAPH_MAX_ROWS=20
TRACEDESK_GRAPH_QUERY_TIMEOUT_SECONDS=10
TRACEDESK_GRAPH_TEXT2CYPHER_ATTEMPTS=2
TRACEDESK_GRAPH_MAX_PROMPT_CHARS=24000
# Text2Cypher 还需要知识嵌入器；语义 few-shot 复用相同模型/维度/批量/超时。
# 随包合成 Cypher 示例仅用于查询提示，不是知识事实；未配置嵌入时不改用零样本。

# Neo4j：数据库账户权限需要单独设置；READ 路由不等于只读授权。
TRACEDESK_NEO4J_URI=bolt://127.0.0.1:7687
TRACEDESK_NEO4J_DATABASE=neo4j
TRACEDESK_NEO4J_READER_USER=
TRACEDESK_NEO4J_READER_PASSWORD=
TRACEDESK_NEO4J_WRITER_USER=
TRACEDESK_NEO4J_WRITER_PASSWORD=

# 官方 Microsoft GraphRAG 2.7.0，需完整依赖、模型配置与实际构建。
TRACEDESK_GRAPHRAG_ENABLED=false
TRACEDESK_GRAPHRAG_ROOT=.tracedesk/graphrag
# 配置存在并启用时再设置；程序不自动加载其 .env。
# TRACEDESK_GRAPHRAG_SETTINGS=.tracedesk/graphrag-config/settings.yaml
TRACEDESK_GRAPHRAG_COMMUNITY_LEVEL=2
TRACEDESK_GRAPHRAG_TIMEOUT_SECONDS=600
# 启用较长 GraphRAG 构建时，还需相应增大 KNOWLEDGE_BUILD_TIMEOUT_SECONDS。

# 研究：multi / single，single 是单研究者加公共 verifier。
TRACEDESK_RESEARCH_MODE=multi
TRACEDESK_RESEARCH_METHODS=lexical,semantic,hybrid,graph,text2cypher
TRACEDESK_RESEARCH_MAX_MODEL_CALLS=16
TRACEDESK_RESEARCH_MAX_TASKS=6
TRACEDESK_RESEARCH_MAX_PARALLEL=3
TRACEDESK_RESEARCH_MAX_CONTEXT_CHARS=240000
TRACEDESK_RESEARCH_MAX_RETRIEVAL_CALLS=8
TRACEDESK_RESEARCH_TIMEOUT_SECONDS=120
# GraphRAG SDK 内部模型调用未接入共享预算，不可加入 RESEARCH_METHODS。
